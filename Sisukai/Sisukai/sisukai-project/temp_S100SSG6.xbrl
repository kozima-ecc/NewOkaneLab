&lt;tbody&gt;
&lt;tr style="height: 13.27px"&gt;
&lt;td style="vertical-align: top; width: 217.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 2px solid #000000; background-color: #C0C6C9"&gt;
&lt;p style="margin-left: 6px; line-height: 21.333333333333333333333333333px; text-align: left"&gt;科目&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 435.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 2px solid #000000; background-color: #C0C6C9"&gt;
&lt;p style="margin-left: 6px; line-height: 21.333333333333333333333333333px; text-align: left"&gt;主な内容&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 44px"&gt;
&lt;td colspan="2" style="vertical-align: top; width: 653px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 2px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left; text-indent: -6px"&gt;有利子負債の収入（以下Ａ～Ｃの合計）&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-bottom: 6px; text-align: left; text-indent: -12px"&gt;4,646,078百万円&lt;/p&gt;
&lt;/td&gt;
