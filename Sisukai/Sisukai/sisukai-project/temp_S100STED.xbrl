&lt;div class="tbld" style="margin-left:10pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:472.6pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:427.6pt;min-width:427.6pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:24pt;min-height:24pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:8pt;line-height:12pt;"&gt;（注）１&lt;/p&gt;
